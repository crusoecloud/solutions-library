# Managed by Ansible — {{ inventory_hostname }}
connections {
    site-vpn {
        version = 2
        local_addrs = %any
        remote_addrs = {{ vpn_remote_gw_ip }}

        local {
            auth = psk
            id = {{ vpn_local_id }}
        }
        remote {
            auth = psk
            id = {{ vpn_remote_id }}
        }

        children {
            site-tunnel {
                local_ts  = {{ vpn_local_subnet }}
                remote_ts = {{ vpn_remote_subnet }}
                start_action = trap
                close_action = start
                dpd_action   = restart
                esp_proposals = {{ vpn_esp_proposals }}
                mode   = tunnel
                reqid  = {{ vpn_xfrm_if_id }}
                if_id_in  = {{ vpn_xfrm_if_id }}
                if_id_out = {{ vpn_xfrm_if_id }}
                rekey_time = {{ vpn_child_rekey_time }}
            }
        }

        proposals = {{ vpn_ike_proposals }}
        dpd_delay = {{ vpn_dpd_delay }}
        rekey_time = {{ vpn_ike_rekey_time }}
    }
}

secrets {
    ike-site {
        id-a = {{ vpn_local_id }}
        id-b = {{ vpn_remote_id }}
        secret = "{{ vpn_psk }}"
    }
}
