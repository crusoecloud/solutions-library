# Expected software / firmware for image ubuntu24.04-amd-mi355-vm-bundle2.2
# (VM type mi355x-288gb-roce.8x). Sourced by env_verify.sh, rail_census.sh,
# pair_rail.sh. Update this file when the bundle changes;
# nothing in the scripts hardcodes a version.
#
# Matching rule: the expected string must appear in the observed version as a
# whole dotted token (so "7.2.0" matches "7.2.0-43" but not "17.2.0").
# Leave a value empty to report-only (status INFO, never fails).
# Any variable can be overridden from the environment (e.g. Ansible `environment:`).

BUNDLE_NAME="${BUNDLE_NAME:-B.MI355.2.2}"
OS_VERSION_ID_EXPECTED="${OS_VERSION_ID_EXPECTED:-24.04}"
KERNEL_EXPECTED="${KERNEL_EXPECTED:-}"                    # report-only by default

ROCM_EXPECTED="${ROCM_EXPECTED:-7.2.0}"
AMDGPU_DKMS_EXPECTED="${AMDGPU_DKMS_EXPECTED:-6.16.13.30300400}"   # amdgpu-dkms 30.30.4
AMDGPU_MODULE_EXPECTED="${AMDGPU_MODULE_EXPECTED:-6.16.13}"        # /sys/module/amdgpu/version
RCCL_EXPECTED="${RCCL_EXPECTED:-2.27.7}"
ANP_EXPECTED="${ANP_EXPECTED:-1.3.0}"
IONIC_FW_EXPECTED="${IONIC_FW_EXPECTED:-1.117.5-a-196}"   # /sys/class/infiniband/ionic_*/fw_ver
IONIC_DRIVER_EXPECTED="${IONIC_DRIVER_EXPECTED:-}"        # /sys/module/ionic/version, report-only until known
OPENMPI_EXPECTED="${OPENMPI_EXPECTED:-4.1.6}"
UCX_EXPECTED="${UCX_EXPECTED:-1.18.0}"
VASTNFS_EXPECTED="${VASTNFS_EXPECTED:-4.5.10}"
GPU_FW_EXPECTED="${GPU_FW_EXPECTED:-1.25.17.10}"          # amd-smi firmware (leading zeros ignored)
GPU_FW_ID="${GPU_FW_ID:-}"                                # optional: restrict match to this FW_ID line (e.g. PLDM_BUNDLE)

# ---- topology ----
GPU_COUNT_EXPECTED="${GPU_COUNT_EXPECTED:-8}"
RAIL_COUNT_EXPECTED="${RAIL_COUNT_EXPECTED:-8}"
RAIL_PREFIX="${RAIL_PREFIX:-ionic_}"
GID_INDEX="${GID_INDEX:-1}"                               # RoCEv2 global GID index used by -x 1 / RCCL
GID_TYPE_EXPECTED="${GID_TYPE_EXPECTED:-RoCE v2}"
GID_PREFIX_EXPECTED="${GID_PREFIX_EXPECTED:-fc01:}"       # rail-plane address prefix; empty = any non-link-local GID
RAIL_MTU_EXPECTED="${RAIL_MTU_EXPECTED:-}"                # netdev MTU on the rails; report-only until known
PCIE_WIDTH_ENFORCE="${PCIE_WIDTH_ENFORCE:-0}"             # 1 = PCIe width < max is FAIL (else WARN)

# ---- recommended sysctls (avoid an IPv6 neighbor-discovery wedge after a rail reset) ----
SYSCTL_EXPECT="${SYSCTL_EXPECT:-net.ipv6.conf.all.ndisc_notify=1 net.ipv6.conf.default.ndisc_notify=1}"

# ---- amd-smi retry (driver reports "not initialized" for the first attempts after boot) ----
AMDSMI_RETRIES="${AMDSMI_RETRIES:-6}"
AMDSMI_RETRY_SLEEP="${AMDSMI_RETRY_SLEEP:-10}"

# ---- dmesg scan ----
DMESG_FAIL_REGEX="${DMESG_FAIL_REGEX:-amdgpu.*(uncorrectable|VRAM is lost|GPU reset begin|ring .* timeout|fatal|RAS.*(error|poison))|BERExceededErr|ionic.*(error|fail|timeout|hang|FW (dead|stopped)|heartbeat)|Hardware Error}"
DMESG_IGNORE_REGEX="${DMESG_IGNORE_REGEX:-Changing MTU from}"

# ---- pair_rail.sh (2-node same-rail ib_write_bw, host memory) ----
PAIR_RAIL_MIN_GBPS="${PAIR_RAIL_MIN_GBPS:-320}"           # per-rail floor (healthy ~389 with 4 QPs)
PAIR_DUR_S="${PAIR_DUR_S:-8}"
PAIR_PORT_BASE="${PAIR_PORT_BASE:-18800}"


# Recommended sysctls (ndisc_notify) are not set by the bundle 2.2 VM image. Missing them is
# a config gap, not a node fault: WARN by default. Set SYSCTL_SEVERITY=FAIL to enforce.
SYSCTL_SEVERITY="${SYSCTL_SEVERITY:-WARN}"

# ib_write_bw with a single QP caps at ~257-267 Gb/s on a 400G Pollara rail; 4 QPs reach
# ~389 Gb/s (measured on bundle 2.2 VMs). Used by pair_rail.sh on both ends.
IBWB_EXTRA="${IBWB_EXTRA:--q 4}"
