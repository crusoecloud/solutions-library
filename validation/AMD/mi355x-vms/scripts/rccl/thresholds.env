# shellcheck shell=bash
# Pass/fail gates for run_rccl_mi355x.sh on mi355x-288gb-roce.8x VMs
# (image ubuntu24.04-amd-mi355-vm-bundle2.2: ROCm 7.2.0, RCCL 2.27.7, AINIC 1.117.5-a-196).
# Every value can be overridden from the environment, e.g. AR_MIN_GBPS_LE8=375 ./run_rccl_mi355x.sh
#
# Units: busbw in GB/s as printed by rccl-tests (out-of-place column), float sum.

# ---- message-size sweep ----
: "${RCCL_MIN_BYTES:=2G}"
: "${RCCL_MAX_BYTES:=32G}"
: "${RCCL_STEP_FACTOR:=2}"
: "${RCCL_ITERS:=50}"
: "${RCCL_WARMUP:=10}"
: "${RCCL_TIMEOUT_S:=900}"      # wall-clock limit per run; exceeding it = HANG

# ---- which statistic is gated ----
# avg  = mean out-of-place busbw over the sweep; peak = best size in the sweep.
# Above 8 nodes the 2G end of the sweep is latency-bound and drags the mean down without
# indicating a fault, so large runs gate on the peak (reached at 16-32G).
: "${GATE_METRIC_LE8:=avg}"
: "${GATE_METRIC_GT8:=peak}"

# ---- all_reduce ----
# Reference: 1 node ~368; 2-16 nodes ~380-384 avg; 32+ nodes peak ~375-385 at 16-32G.
: "${AR_MIN_GBPS_1N:=360}"
: "${AR_MIN_GBPS_LE8:=370}"
: "${AR_MIN_GBPS_GT8:=360}"

# ---- all_gather ----
# Reference: 32+ nodes peak ~360-382 (varies run to run at this scale).
: "${AG_MIN_GBPS_1N:=330}"
: "${AG_MIN_GBPS_LE8:=340}"
: "${AG_MIN_GBPS_GT8:=340}"

# ---- reduce_scatter (optional collective) ----
: "${RS_MIN_GBPS_1N:=330}"
: "${RS_MIN_GBPS_LE8:=340}"
: "${RS_MIN_GBPS_GT8:=360}"

# ---- alltoall (optional collective; needs PXN, set automatically by the runner) ----
# Report-only until a reference is established on this image.
: "${A2A_MIN_GBPS_1N:=0}"
: "${A2A_MIN_GBPS_LE8:=0}"
: "${A2A_MIN_GBPS_GT8:=0}"
