# shellcheck shell=bash
# Pass/fail gates for run_nccl_gb200.sh on GB200 VMs (gb200-186gb-nvl*.4x, 4 GPUs per VM)
# in one NVLink domain. Every value can be overridden from the environment.
#
# Units: busbw in GB/s as printed by nccl-tests (out-of-place column), float sum.

# ---- message-size sweep ----
: "${NCCL_MIN_BYTES:=2G}"
: "${NCCL_MAX_BYTES:=32G}"
: "${NCCL_STEP_FACTOR:=2}"
: "${NCCL_ITERS:=50}"
: "${NCCL_WARMUP:=10}"
: "${NCCL_TIMEOUT_S:=900}"      # wall-clock limit per run; exceeding it = HANG

# ---- which statistic is gated ----
# avg = mean out-of-place busbw over the sweep; peak = best size. Inside one NVLink domain the
# whole 2G-32G sweep stays near line rate, so the mean is gated at every scale.
: "${GATE_METRIC_LE8:=avg}"
: "${GATE_METRIC_GT8:=avg}"

# ---- all_reduce ----
# Reference (2G-32G): 1 VM ~681; 2 VMs ~834; 16 VMs ~888 avg; full 18-VM rack ~870 avg / ~929 peak.
: "${AR_MIN_GBPS_1N:=640}"
: "${AR_MIN_GBPS_LE8:=780}"
: "${AR_MIN_GBPS_GT8:=800}"

# ---- all_gather ----
# Reference: full rack ~680 avg.
: "${AG_MIN_GBPS_1N:=0}"         # report only on a single VM (no reference yet)
: "${AG_MIN_GBPS_LE8:=600}"
: "${AG_MIN_GBPS_GT8:=650}"

# ---- reduce_scatter (optional collective) ----
: "${RS_MIN_GBPS_1N:=0}"
: "${RS_MIN_GBPS_LE8:=600}"
: "${RS_MIN_GBPS_GT8:=650}"

# ---- alltoall (optional; runner sets NCCL_P2P_LEVEL=NVL) ----
: "${A2A_MIN_GBPS_1N:=0}"
: "${A2A_MIN_GBPS_LE8:=0}"
: "${A2A_MIN_GBPS_GT8:=600}"
