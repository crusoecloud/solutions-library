# shellcheck shell=bash
# Expected software / hardware state for image ubuntu24.04-nvidia-b.gb200.1.0 on
# gb200-186gb-nvl*.4x VMs. Sourced by env_verify.sh. Every value can be overridden from the
# environment; update this file when the image changes. Empty = report only.

OS_VERSION_ID_EXPECTED="${OS_VERSION_ID_EXPECTED:-24.04}"
ARCH_EXPECTED="${ARCH_EXPECTED:-aarch64}"
DRIVER_EXPECTED="${DRIVER_EXPECTED:-580.178.04}"
CUDA_EXPECTED="${CUDA_EXPECTED:-13.0}"            # prefix match against nvidia-smi "CUDA Version"
DCGM_EXPECTED="${DCGM_EXPECTED:-4.6.1}"
DOCA_EXPECTED="${DOCA_EXPECTED:-3.2.1}"           # prefix match against ofed_info / doca packages
KERNEL_EXPECTED="${KERNEL_EXPECTED:-6.11.0-161.crusoe}"  # prefix match

GPU_COUNT_EXPECTED="${GPU_COUNT_EXPECTED:-4}"
GPU_NAME_REGEX="${GPU_NAME_REGEX:-GB200}"

# InfiniBand rails (gb200-186gb-nvl-ib.4x only). Rails are IB ports at this rate; the
# lower-rate frontend NIC is ignored. Set IB_RAILS_EXPECTED=0 for gb200-186gb-nvl.4x.
IB_RAILS_EXPECTED="${IB_RAILS_EXPECTED:-4}"
IB_RAIL_RATE_GBPS="${IB_RAIL_RATE_GBPS:-400}"

# Severity for version mismatches: FAIL (pinned bundle) or WARN.
VERSION_SEVERITY="${VERSION_SEVERITY:-FAIL}"

# dmesg patterns that fail a node, and benign ones to ignore.
# Xids that only mean an application's GPU work was torn down (killed/crashed process, app fault,
# page fault in user code) -> WARN. Any other Xid (e.g. 48 DBE, 63/64 row remap, 74 NVLink,
# 79 fallen off bus, 92/94/95 ECC, 119/120 GSP) -> FAIL.
# Also FAIL: local NVMe controllers dropping off the bus and the XFS shutdown that follows.
XID_APP_CODES="${XID_APP_CODES:-13 31 43 45 68}"
DMESG_FAIL_REGEX="${DMESG_FAIL_REGEX:-NVRM: Xid|NVRM: GPU at .* has fallen off the bus|nvidia-imex.*(error|fail)|mlx5_core.*(fatal|health compromised)|Hardware Error|nvme.*(controller is down|Disabling device after reset failure)|XFS \(.*\): (Filesystem has been shut down|log I/O error)}"
DMESG_IGNORE_REGEX="${DMESG_IGNORE_REGEX:-}"
