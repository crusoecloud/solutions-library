          "expr": "avg(max without (pod, namespace, container, cluster_name, ib_network_id, ib_network_name, node_id, nodepool_name, pod_id, deployment_mode) (last_over_time(gpu_gfx_activity{cluster_id=~\"$cluster\", vm_name=~\"$node\"}[$fresh])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
