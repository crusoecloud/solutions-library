          "expr": "sum by (vm_name) (max without (pod, namespace, container, cluster_name, ib_network_id, ib_network_name, node_id, nodepool_name, pod_id, deployment_mode) (rate(gpu_xgmi_link_tx{cluster_id=~\"$cluster\", vm_name=~\"$node\"}[$__rate_interval])))",
