    {
      "id": 15,
      "type": "timeseries",
      "title": "XGMI TX by Node",
      "description": "XGMI is AMD's die-to-die / GPU-to-GPU interconnect, the analogue of NVIDIA NVLink. Counters are cumulative; this charts their rate. AMD's exporter documents these counters in KB, so the unit is set to KiB/s \u2014 treat the absolute scale as indicative and the relative shape as reliable.",
      "datasource": {
        "type": "prometheus",
        "uid": "crusoe-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
