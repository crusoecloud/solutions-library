{
  "annotations": {
    "list": []
  },
  "description": "Live SLO view of vLLM inference servers scraped by the in-cluster prometheus-vllm (crusoe-kserve-example). Covers TTFT/TPOT latency SLAs, prefix-cache hit rate, per-node tokens/s, queue depth, and API-endpoint usage. Note: vLLM exposes no per-user identity on /metrics — the endpoint table is the closest available proxy for 'who is using the server'.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "count(count by (pod) (vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}))",
          "refId": "A"
        }
      ],
      "title": "vLLM servers up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Requests currently executing (decode in flight).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "sum(vllm:num_requests_running{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"})",
          "refId": "A"
        }
      ],
      "title": "Requests running",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Requests queued waiting for a KV slot. Anything >0 under load means batch limit reached; sustained queue = add replicas or raise max-num-seqs.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 16 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "sum(vllm:num_requests_waiting{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"})",
          "refId": "A"
        }
      ],
      "title": "Requests waiting",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Cluster-wide decode token rate (generation tokens per second).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "sum(rate(vllm:generation_tokens_total{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Generation tokens/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Cluster-wide prefill token rate (prompt tokens per second).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "sum(rate(vllm:prompt_tokens_total{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Prompt tokens/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Fraction of prefix-cache queries that hit. Low hit rate with long shared system prompts usually means the cache is being evicted (KV pressure) or clients vary the prompt prefix.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.6 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "sum(rate(vllm:prefix_cache_hits_total{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])) / sum(rate(vllm:prefix_cache_queries_total{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Prefix-cache hit rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Time-to-first-token SLAs. Threshold = 2 s on p99 (tune the panel thresholds to your contract). TTFT tracks prefill queue + prefill compute; p99 excursions with idle GPUs point at queueing, not kernels.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "TTFT quantiles (SLA: p99 < 2 s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "Time-per-output-token SLAs (inter-token decode latency). Threshold = 100 ms on p99. TTOT p99 creeping up under load = batch too large or KV bandwidth saturated.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vllm-local" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:request_time_per_output_token_seconds_bucket{namespace=~\"$namespace\", model_name=~\"$model\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "TPOT quantiles (SLA: p99 < 100 ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "vllm-local" },
      "description": "End-to-end request latency quantiles (queue + prefill + decode). Inherently output-length dependent — use TTFT/TPOT for SLA enforcement; this is the user-experience view.",
      "fieldConfig": {
